---
import "../styles/global.css";

const picks = [
  ["Beauty Products", "Barrier Reset Trio", "Gentle cleanser, ceramide cream, and sunscreen for calm everyday glow.", "Dry or sensitive skin"],
  ["Makeup Picks", "Soft Glow Kit", "Tinted base, cream blush, brow gel, and lip oil for five-minute polish.", "Low-effort beauty days"],
  ["Health Products", "Daily Care Stack", "Hydration bottle, magnesium ritual, stretch band, and sleep wind-down.", "Busy founders and creators"],
];

const events = [
  ["Glow Walk", "Morning movement, matcha, and intention setting for founders."],
  ["Routine Lab", "Bring your products and build a realistic AM/PM flow with the community."],
  ["Founder Circle", "Quiet accountability for women building beautiful things with care."],
];

const notes = [
  "Personal essays on creativity, identity, beauty, and building in public.",
  "Product reviews with context: skin concern, routine fit, budget, and repurchase notes.",
  "Wellness reflections for water, sleep, movement, mood, confidence, and gentle ambition.",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Glow & Grow Studio is a Founders Community personal brand website for beauty, wellness, self-care, product picks, content, and community events." />
    <title>Glow & Grow Studio | Founders Community</title>
    <link rel="icon" type="image/svg+xml" href="/glow_grow_logo.svg" />
    <link rel="preload" as="image" href="/glow_grow_hero.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Glow & Grow Studio home"><span class="brand-mark">G&G</span><span>Glow & Grow Studio</span></a>
      <nav aria-label="Primary navigation"><a href="#story">Story</a><a href="#picks">Picks</a><a href="#community">Founders</a><a href="#apps">Apps</a></nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-media" role="img" aria-label="Sunlit vanity with skincare, journal, tea, and wellness details"></div>
        <div class="hero-copy">
          <p class="eyebrow">Founders Community for beauty, wellness, and self-care</p>
          <h1>Glow & Grow Studio</h1>
          <p>A beautifully designed personal brand home and community hub for warm routines, thoughtful product curation, creative projects, founder wellness, and small tools that make growth feel gentle.</p>
          <div class="hero-actions"><a class="button primary" href="#apps">Try a mini app</a><a class="button secondary" href="#community">Enter Founders Community</a></div>
        </div>
      </section>

      <section id="story" class="section intro-grid">
        <div><p class="eyebrow">Personal portfolio</p><h2>A soft place for the whole story</h2><p>Glow & Grow Studio brings together story, hobbies, creativity, writing, design taste, wellness rituals, product notes, and projects in one living home. It is personal without being messy, polished without losing warmth.</p></div>
        <div class="profile-panel"><span>Current themes</span><strong>skin confidence, founder energy, slow self-care, creative systems, community rituals</strong></div>
      </section>

      <section id="picks" class="section">
        <div class="section-heading"><p class="eyebrow">Product curation</p><h2>Beauty and health picks with a founder-friendly point of view</h2></div>
        <div class="card-grid">{picks.map(([category, name, note, match]) => <article class="pick-card"><span>{category}</span><h3>{name}</h3><p>{note}</p><small>Best for: {match}</small></article>)}</div>
      </section>

      <section class="section split">
        <div><p class="eyebrow">Content studio</p><h2>Guides, reflections, routines, and reviews</h2><p>Lifestyle writing can live beside product reviews, personal growth notes, beauty routines, wellness reflections, member stories, and behind-the-scenes creative work.</p></div>
        <div class="list-panel">{notes.map((note) => <a href="#apps">{note}</a>)}</div>
      </section>

      <section id="community" class="section community">
        <div class="section-heading"><p class="eyebrow">Founders Community</p><h2>Founders Club, wellness meetups, challenges, and member stories</h2></div>
        <div class="event-row">{events.map(([name, description]) => <article class="event-card"><h3>{name}</h3><p>{description}</p><button class="mini-button" type="button">Save seat</button></article>)}</div>
      </section>

      <section id="apps" class="section apps">
        <div class="section-heading"><p class="eyebrow">Vibe code apps</p><h2>Small tools that make self-care feel personal</h2></div>
        <div class="tool-grid enhanced-tools">
          <article class="tool-card"><div class="tool-title"><h3>Skin Type Finder</h3><span>Routine logic</span></div><p class="tool-note">Map skin feel, sensitivity, and current goal into a simple care priority.</p><label>Midday skin feel<select id="skinInput"><option value="balanced">Comfortable and steady</option><option value="dry">Tight or flaky</option><option value="oily">Shiny through the T-zone</option><option value="sensitive">Reactive or easily red</option></select></label><label>Sensitivity level<input id="skinSensitivity" type="range" min="1" max="5" value="3" /></label><label>Main goal<select id="skinGoal"><option value="barrier">Repair barrier</option><option value="glow">Boost glow</option><option value="texture">Smooth texture</option><option value="calm">Calm redness</option></select></label><button type="button" data-tool="skin">Find routine</button><div class="result rich-result" id="skinResult">Choose your skin profile to get priorities, ingredients, and steps.</div></article>
          <article class="tool-card"><div class="tool-title"><h3>Beauty Routine Builder</h3><span>AM / PM flow</span></div><p class="tool-note">Build a realistic routine around time, moment, and effort level.</p><label>Routine moment<select id="routineInput"><option value="morning">Morning</option><option value="night">Night</option><option value="event">Before an event</option></select></label><label>Time available<select id="routineTime"><option value="5">5 minutes</option><option value="10">10 minutes</option><option value="20">20 minutes</option></select></label><label>Finish style<select id="routineFinish"><option value="natural">Natural glow</option><option value="polished">Soft polished</option><option value="minimal">Minimal reset</option></select></label><button type="button" data-tool="routine">Build steps</button><div class="result rich-result" id="routineResult">Your custom order, focus, and skip rules will appear here.</div></article>
          <article class="tool-card"><div class="tool-title"><h3>Wellness Habit Tracker</h3><span>Daily check-in</span></div><p class="tool-note">Track care wins and get a kind next step instead of an all-or-nothing score.</p><div class="checks"><label><input type="checkbox" value="Water" /> Water</label><label><input type="checkbox" value="Sleep" /> Sleep</label><label><input type="checkbox" value="Movement" /> Movement</label><label><input type="checkbox" value="Mood" /> Mood</label></div><label>Energy today<input id="energyInput" type="range" min="1" max="5" value="3" /></label><label>Sleep hours<input id="sleepInput" type="number" min="0" max="12" value="7" /></label><button type="button" data-tool="habits">Check in</button><div class="result rich-result" id="habitResult">Log wins to get your care score, pattern, and next tiny action.</div></article>
          <article class="tool-card"><div class="tool-title"><h3>Product Match Quiz</h3><span>Curated picks</span></div><p class="tool-note">Match beauty or wellness products by concern, texture preference, and budget.</p><label>Biggest concern<select id="productInput"><option value="glow">Dullness</option><option value="calm">Redness</option><option value="energy">Low energy</option><option value="sleep">Poor sleep</option></select></label><label>Preference<select id="productPreference"><option value="gentle">Gentle and sensitive-safe</option><option value="fast">Fast visible payoff</option><option value="low">Low-maintenance</option><option value="ritual">Ritual feeling</option></select></label><label>Budget lane<select id="productBudget"><option value="starter">Starter</option><option value="mid">Mid-range</option><option value="treat">Treat-yourself</option></select></label><button type="button" data-tool="product">Match me</button><div class="result rich-result" id="productResult">Your product lane, ingredient cues, and review checklist will appear here.</div></article>
          <article class="tool-card"><div class="tool-title"><h3>Self-Care Planner</h3><span>Weekly map</span></div><p class="tool-note">Create a weekly founder-friendly care plan around capacity and focus.</p><label>Week type<select id="plannerInput"><option value="steady">Steady and full</option><option value="launch">Launch or event week</option><option value="recovery">Recovery week</option><option value="social">Social and community week</option></select></label><label>Capacity<select id="plannerCapacity"><option value="low">Low capacity</option><option value="medium">Medium capacity</option><option value="high">High capacity</option></select></label><label>Anchor habit<select id="plannerAnchor"><option value="sleep">Sleep</option><option value="movement">Movement</option><option value="meal">Meals</option><option value="beauty">Beauty reset</option></select></label><button type="button" data-tool="planner">Plan week</button><div class="result rich-result" id="plannerResult">Your weekly rhythm, anchors, and boundaries will appear here.</div></article>
          <article class="tool-card"><div class="tool-title"><h3>Mood-to-Routine Generator</h3><span>Care response</span></div><p class="tool-note">Translate mood into a self-care routine with a first step, body cue, and closing ritual.</p><label>Current mood<select id="moodInput"><option value="tired">Tired</option><option value="anxious">Anxious</option><option value="confident">Confident</option><option value="unfocused">Unfocused</option></select></label><label>Intensity<input id="moodIntensity" type="range" min="1" max="5" value="3" /></label><label>Available window<select id="moodWindow"><option value="5">5 minutes</option><option value="15">15 minutes</option><option value="30">30 minutes</option></select></label><button type="button" data-tool="mood">Generate</button><div class="result rich-result" id="moodResult">Your mood-based care path will appear here.</div></article>
        </div>
      </section>
    </main>

    <footer><strong>Glow & Grow Studio</strong><span>Founders Community for curated beauty, grounded wellness, and community-led self-care.</span></footer>
    <script is:inline src="/app.js"></script>
  </body>
</html>
