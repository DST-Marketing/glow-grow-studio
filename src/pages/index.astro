---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Glow-Grow-Studio is a personal Founders Club community hub for tracing lists, downline updates, talks, meetings, games, sports, wellness, and networking."
    />
    <meta
      name="keywords"
      content="Glow-Grow-Studio, Founders Club, Connect Move Grow, community hub, downline updates, tracing list, networking community, wellness community"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://glow-grow-studio.pages.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Glow-Grow-Studio | Founders Club Community Hub" />
    <meta
      property="og:description"
      content="A warm personal community front door for Founders Club, built around Connect, Move, Grow, real conversations, sports, networking, tracing lists, and downline updates."
    />
    <meta property="og:url" content="https://glow-grow-studio.pages.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Glow-Grow-Studio | Founders Club Community, Talks & Downline Updates</title>
    <link rel="preconnect" href="https://images.unsplash.com" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Glow-Grow-Studio",
        "url": "https://glow-grow-studio.pages.dev/",
        "description": "Glow-Grow-Studio is a warm personal community hub connected with Founders Club, built around Connect, Move, Grow, tracing lists, downline updates, talks, meetings, games, sports, wellness, and networking.",
        "brand": {
          "@type": "Brand",
          "name": "Founders Club"
        }
      }
    </script>
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="brand" href="#top" aria-label="Glow-Grow-Studio home">
        <span class="brand-badge">GG</span>
        <span>
          <strong>Glow-Grow-Studio</strong>
          <small>Founders Club community</small>
        </span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#community">Community</a>
        <a href="#system">System</a>
        <a href="#events">Events</a>
        <a href="#updates">Updates</a>
        <a href="#join">Join</a>
      </nav>

      <a class="header-cta" href="https://www.foundersclub.asia/" target="_blank" rel="noopener noreferrer">
        Founders Club
      </a>
    </header>

    <main id="top">
      <section class="hero-section">
        <div class="hero-copy">
          <p class="eyebrow">A cozy personal lounge connected with Founders Club</p>
          <h1>Gather your people before they enter the club.</h1>
          <p>
            Glow-Grow-Studio is your gentle pre-community space for warm invites, real
            conversations, downline updates, coffee chats, games, sports, and networking. It
            supports the Founders Club rhythm: Connect, Move, and Grow.
          </p>

          <div class="hero-actions" aria-label="Primary actions">
            <a class="button primary" href="#join">Plan a warm invite</a>
            <a class="button secondary" href="#community">Explore the circle</a>
          </div>

          <dl class="hero-metrics" aria-label="Community snapshot">
            <div>
              <dt>24</dt>
              <dd>warm connections</dd>
            </div>
            <div>
              <dt>7</dt>
              <dd>gentle follow-ups</dd>
            </div>
            <div>
              <dt>4</dt>
              <dd>club pillars</dd>
            </div>
          </dl>
        </div>

        <div class="hero-visual" aria-label="Animated Glow-Grow-Studio hero visual">
          <div class="hero-orbit" aria-hidden="true">
            <span class="hero-glow glow-one"></span>
            <span class="hero-glow glow-two"></span>
            <span class="hero-card card-one"></span>
            <span class="hero-card card-two"></span>
            <span class="hero-card card-three"></span>
            <span class="hero-ring ring-one"></span>
            <span class="hero-ring ring-two"></span>
            <span class="hero-ring ring-three"></span>
            <span class="hero-core">GG</span>
            <span class="hero-pill pill-connect">Connect</span>
            <span class="hero-pill pill-move">Move</span>
            <span class="hero-pill pill-grow">Grow</span>
            <span class="hero-particle particle-one"></span>
            <span class="hero-particle particle-two"></span>
            <span class="hero-particle particle-three"></span>
            <span class="hero-particle particle-four"></span>
          </div>
          <div class="hero-visual-caption">
            <strong>Connect. Move. Grow.</strong>
            <span>A cozy orbit for warm invites, coffee chats, sports, and founder-minded conversations.</span>
          </div>
        </div>
      </section>

      <section id="community" class="section intro-grid">
        <div class="section-kicker">
          <p class="eyebrow">Community purpose</p>
          <h2>A warm personal bridge into the Founders Club way: Connect, Move, Grow.</h2>
        </div>
        <div class="intro-copy">
          <p>
            Founders Club is built for high-value connection without empty small talk. Glow-Grow-Studio
            softens the first step: a cozy place to prepare people, understand their interests,
            invite them naturally, and help them feel at home before joining the wider tribe.
          </p>
          <div class="principles">
            <span>Real talk</span>
            <span>Warm invites</span>
            <span>Founder mindset</span>
          </div>
        </div>
      </section>

      <section id="system" class="section system-section">
        <div class="section-heading">
          <p class="eyebrow">The community rhythm</p>
          <h2>A simple rhythm for warm relationships, not cold recruiting.</h2>
          <p>
            Notice the people around you, understand their vibe, invite them into the right moment,
            then keep your circle updated with a caring next step.
          </p>
        </div>

        <div class="system-grid">
          <article class="system-card">
            <span>01</span>
            <h3>Notice</h3>
            <p>Keep track of friends, sports circles, coffee chats, product sharing, and referrals.</p>
          </article>
          <article class="system-card">
            <span>02</span>
            <h3>Understand</h3>
            <p>Group people by their vibe: real talk, games, badminton, networking, wellness, or business.</p>
          </article>
          <article class="system-card">
            <span>03</span>
            <h3>Invite</h3>
            <p>Send a simple, low-pressure invitation to the most natural Founders Club moment.</p>
          </article>
          <article class="system-card">
            <span>04</span>
            <h3>Nurture</h3>
            <p>Share gentle updates so your downline knows who joined and who needs a warm follow-up.</p>
          </article>
        </div>
      </section>

      <section id="events" class="section events-section">
        <div class="section-heading narrow">
          <p class="eyebrow">Community moments</p>
          <h2>Invite people into experiences that feel easy to say yes to.</h2>
        </div>

        <div class="event-board">
          <article class="event-card large">
            <div>
              <span class="tag">Coffee with Founders</span>
              <h3>Before they join, let them feel the story.</h3>
              <p>
                Use coffee chats, small-room sharing, and guided discussion to help people feel
                included before they take a bigger step.
              </p>
            </div>
          </article>
          <article class="event-card">
            <span class="tag cyan-tag">Connect</span>
            <h3>Casual entry points</h3>
            <p>Simple group activities that make first contact easier, warmer, and less formal.</p>
          </article>
          <article class="event-card photo-card">
            <span>Move together</span>
          </article>
          <article class="event-card">
            <span class="tag rose-tag">Grow</span>
            <h3>Warm introductions</h3>
            <p>Connect people through shared goals, support, real conversations, and gentle momentum.</p>
          </article>
        </div>
      </section>

      <section id="updates" class="section updates-section">
        <div class="update-panel">
          <div>
            <p class="eyebrow">Circle update format</p>
            <h2>Make every update feel personal, clear, and kind.</h2>
            <p>
              A good update should tell your circle who is new, what is happening next, who needs
              a warm follow-up, and which activity feels like the best invite this week.
            </p>
          </div>

          <div class="update-template" aria-label="Weekly update template">
            <div class="template-row">
              <strong>New people</strong>
              <span>3 warm names from badminton and coffee chats</span>
            </div>
            <div class="template-row">
              <strong>Next moment</strong>
              <span>Coffee with Founders, Thursday Move session</span>
            </div>
            <div class="template-row">
              <strong>Warm follow-up</strong>
              <span>7 people need a personal reminder</span>
            </div>
            <div class="template-row">
              <strong>Invite angle</strong>
              <span>Connect, Move, Grow, wellness, or networking</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section member-section">
        <div class="section-heading">
          <p class="eyebrow">Designed to expand</p>
          <h2>Start cozy and personal, then grow into a trusted community rhythm.</h2>
        </div>

        <div class="member-grid">
          <article>
            <h3>Starter circle</h3>
            <p>Your close friends, warm leads, and people already comfortable in conversation.</p>
          </article>
          <article>
            <h3>Active downline</h3>
            <p>People who need updates, event reminders, encouragement, and clear next steps.</p>
          </article>
          <article>
            <h3>Open community</h3>
            <p>A future invite page for more people to join coffee chats, sports, games, and networking.</p>
          </article>
        </div>
      </section>

      <section id="join" class="section join-section">
        <div class="join-shell">
          <div>
            <p class="eyebrow">Plan the next warm invite</p>
            <h2>Create a cozy draft update for your next community follow-up.</h2>
            <p>
              This form previews the future member update tool: a simple way to turn your thoughts
              into a kind message before inviting someone into the Founders Club vibe.
            </p>
          </div>

          <form class="invite-form" id="inviteForm">
            <label>
              Person or small circle
              <input id="groupInput" type="text" placeholder="Example: Badminton friends" />
            </label>
            <label>
              Best fit
              <select id="interestInput">
                <option>Coffee with Founders</option>
                <option>Connect: games and networking</option>
                <option>Move: sports and wellness</option>
                <option>Grow: mindset and business</option>
                <option>Warm product sharing</option>
              </select>
            </label>
            <label>
              Warm next step
              <textarea id="actionInput" placeholder="Example: Invite to Coffee with Founders and send a friendly reminder on Friday"></textarea>
            </label>
            <button type="submit">Generate cozy update</button>
          </form>

          <aside class="draft-preview" aria-live="polite">
            <span>Draft preview</span>
            <h3 id="previewTitle">Badminton friends</h3>
            <p id="previewBody">
              Invite this circle to Move: sports and wellness. Suggested next step: confirm the
              next cozy community moment and send a warm reminder.
            </p>
          </aside>
        </div>
      </section>
    </main>

    <footer>
      <strong>Glow-Grow-Studio</strong>
      <span>A warm personal community lounge connected with Founders Club.</span>
      <a href="https://www.foundersclub.asia/" target="_blank" rel="noopener noreferrer">Founders Club Asia</a>
    </footer>

    <script is:inline src="/app.js"></script>
  </body>
</html>
